{
  "architecture": "outsourced-pir-execution",
  "version": "1.0",
  "created": "2026-08-17",
  "description": "All PIR execution outsourced to DeerFlow + OSINT stack. Hermes cronjobs are orchestrators only.",

  "deerflow_config": {
    "url": "http://localhost:2026",
    "gateway_url": "http://localhost:2026",
    "langgraph_url": "http://localhost:2026/api/langgraph",
    "default_mode": "ultra",
    "timeout_seconds": 900
