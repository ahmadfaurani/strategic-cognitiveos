  "osint_stack": {
    "firecrawl": {
      "url": "http://localhost:3002",
      "mcp_available": true,
      "use_for": ["web_search", "page_scraping", "structured_extraction"]
    },
    "searxng": {
      "url": "http://127.0.0.1:8080",
      "use_for": ["federated_search", "news_aggregation"],
      "fallback_only": true,
      "note": "IP-blocked engines — use as secondary to Firecrawl"
    },
    "web_extract": {
      "use_for": ["direct_url_extraction", "pdf_extraction"],
      "always_available": true
    }
  },

