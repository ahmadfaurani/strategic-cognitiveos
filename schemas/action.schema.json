{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "action.schema.json",
  "title": "Action Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "owner",
    "status",
    "required_output"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ACT-\\d{8}-\\d{3}$"
    },
    "record_type": {
      "const": "action"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when action was completed. Required when status=completed."
    },
    "owner": {
      "type": "string",
      "description": "Accountable owner."
    },
    "assignee": {
      "type": "string",
      "description": "Person executing the action. Distinct from owner (accountable)."
    },
    "co_owner": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional shared owners."
    },
    "previous_owner": {
      "type": "string",
      "description": "Prior owner before transfer."
    },
    "delegated_by": {
      "type": "string",
      "description": "Who delegated this action."
    },
    "action_type": {
      "type": "string",
      "enum": [
        "hiring",
        "delivery",
        "validation",
        "governance",
        "engagement",
        "analysis",
        "administrative"
      ],
      "description": "Category of action."
    },
    "related_initiative": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Links to INIT records. Array to support multiple initiatives."
    },
    "related_stakeholder": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Links to STK records. Array to support multiple stakeholders."
    },
    "predecessor": {
      "type": "string",
      "description": "Prior action in a sequence (ACT-ID)."
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "validated",
        "approved",
        "active",
        "blocked",
        "deferred",
        "completed",
        "superseded",
        "archived",
        "captured",
        "open",
        "proposed",
        "pending",
        "overdue",
        "cancelled",
        "unresolved"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "candidate",
        "structurally_valid",
        "semantically_verified",
        "approved",
        "canonical",
        "superseded",
        "rejected"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "controlled"
      ]
    },
    "classification": {
      "type": "string",
      "description": "Formal classification marking (e.g., OSA-1972-aware). Distinct from sensitivity."
    },
    "deadline": {
      "type": "string",
      "format": "date"
    },
    "dependency": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What must happen first. Array to support multiple dependencies."
    },
    "required_output": {
      "type": [
        "string",
        "null"
      ],
      "description": "Description of the expected deliverable. Can be null for records where output is implicit."
    },
    "attention_level": {
      "type": "string",
      "enum": [
        "immediate",
        "critical",
        "high",
        "medium",
        "low",
        "monitored",
        "strategic",
        "deferred"
      ],
      "description": "Urgency/attention level. 'immediate' for time-critical actions."
    },
    "completion_evidence": {
      "type": "string",
      "description": "What proves the action is done. Required when status=completed."
    },
    "validation_note": {
      "type": "string",
      "description": "SOP-AV-001 validation evidence and rule reference."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "strategic_significance": {
      "type": "string"
    },
    "mission_alignment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
