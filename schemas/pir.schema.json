{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pir.schema.json",
  "title": "Priority Intelligence Requirement Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "owner",
    "status",
    "pir_priority",
    "pir_tier"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PIR-\\d{8}-\\d{3}$"
    },
    "record_type": {
      "const": "pir"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "validated",
        "approved",
        "active",
        "blocked",
        "deferred",
        "completed",
        "superseded",
        "archived",
        "captured",
        "ready_for_submission",
        "ready_for_review",
        "fulfilled",
        "open",
        "proposed",
        "pending",
        "overdue",
        "cancelled",
        "unresolved",
        "identified"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "controlled"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "candidate",
        "structurally_valid",
        "semantically_verified",
        "approved",
        "canonical",
        "superseded",
        "rejected"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "strategic_significance": {
      "type": "string"
    },
    "mission_alignment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pir_priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "pir_tier": {
      "type": "string",
      "enum": [
        "tier-1-immediate",
        "tier-2-routine",
        "tier-3-background",
        "Tier 1",
        "Tier 2",
        "Tier 3"
      ]
    },
    "collection_cycle": {
      "type": "string",
      "enum": [
        "continuous",
        "daily",
        "weekly",
        "bi-weekly",
        "monthly",
        "quarterly"
      ]
    },
    "related_intelligence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "last_collected": {
      "type": "string",
      "format": "date-time"
    },
    "next_collection": {
      "type": "string",
      "format": "date-time"
    }
  }
}
