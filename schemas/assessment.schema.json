{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment.schema.json",
  "title": "Assessment Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "owner",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ASSESS-\\d{8}-\\d{3}$"
    },
    "record_type": {
      "const": "assessment"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "validated",
        "approved",
        "active",
        "blocked",
        "deferred",
        "completed",
        "superseded",
        "archived",
        "captured",
        "ready_for_submission",
        "ready_for_review",
        "fulfilled",
        "open",
        "proposed",
        "pending",
        "overdue",
        "cancelled",
        "unresolved",
        "identified"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "controlled"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "candidate",
        "structurally_valid",
        "semantically_verified",
        "approved",
        "canonical",
        "superseded",
        "rejected"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        },
        "platform": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "strategic_significance": {
      "type": "string"
    },
    "mission_alignment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment_type": {
      "type": "string",
      "enum": [
        "framework-application",
        "gap-analysis",
        "readiness-assessment",
        "stakeholder-evaluation",
        "risk-assessment",
        "engineered-success-application",
        "financial-operational"
      ]
    },
    "assessment_target": {
      "type": "string"
    },
    "assessment_date": {
      "type": "string",
      "format": "date"
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessed_by": {
      "type": "string"
    },
    "subject_period": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
