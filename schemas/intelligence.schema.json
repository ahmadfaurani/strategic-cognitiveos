{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "intelligence.schema.json",
  "title": "Intelligence Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "intelligence_type",
    "status",
    "summary",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^INT-\\d{8}-\\d{3}$"
    },
    "record_type": {
      "const": "intelligence"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string"
    },
    "intelligence_type": {
      "type": "string",
      "enum": [
        "stakeholder",
        "political",
        "market",
        "technical",
        "competitive",
        "pir-collection",
        "operational"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "validated",
        "active",
        "superseded",
        "archived"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "controlled"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "candidate",
        "structurally_valid",
        "semantically_verified",
        "approved",
        "canonical",
        "superseded",
        "rejected"
      ]
    },
    "summary": {
      "type": "string"
    },
    "strategic_significance": {
      "type": "string"
    },
    "mission_alignment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "assessment": {
      "type": "string"
    },
    "implications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_initiatives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_stakeholders": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    }
  }
}
