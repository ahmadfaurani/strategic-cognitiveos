{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "commitment.schema.json",
  "title": "Commitment Record",
  "type": "object",
  "required": [
    "id",
    "record_type",
    "title",
    "owner",
    "status",
    "expected_delivery_date"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^COM-\\d{8}-\\d{3}$"
    },
    "record_type": {
      "const": "commitment"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner": {
      "type": "string",
      "description": "Commitment owner"
    },
    "receiving_stakeholder": {
      "type": "string"
    },
    "source_engagement": {
      "type": "string"
    },
    "expected_delivery_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "in-progress",
        "validated",
        "approved",
        "active",
        "blocked",
        "deferred",
        "completed",
        "superseded",
        "archived",
        "captured",
        "delivered"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "candidate",
        "structurally_valid",
        "semantically_verified",
        "approved",
        "canonical",
        "superseded",
        "rejected"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low"
      ]
    },
    "sensitivity": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted",
        "controlled"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_of_non_delivery": {
      "type": "string"
    },
    "escalation_date": {
      "type": "string",
      "format": "date"
    },
    "completion_evidence": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "strategic_significance": {
      "type": "string"
    },
    "mission_alignment": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "related_records": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "committed_by": {
      "type": "string"
    },
    "committed_to": {
      "type": "string"
    },
    "related_initiative": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "deadline": {
      "type": "string"
    },
    "commitment_maker": {
      "type": "string"
    },
    "channel": {
      "type": "string"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
