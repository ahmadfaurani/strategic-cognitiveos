    "automated_triggers": [
      {
        "trigger_id": "TRIGGER-001",
        "name": "NameTag Media Mention",
        "query": "\"NameTag\" + (Meta OR \"smart glasses\" OR \"facial recognition\")",
        "sources": ["Google News", "Twitter/X", "Reddit"],
        "action": "Create collection item in OSINT/",
        "priority": "HIGH",
        "notification": "Telegram alert to analyst"
      },
      {
        "trigger_id": "TRIGGER-002",
        "name": "Meta AI App Update",
        "query": "Meta AI app version change (App Store / Play Store)",
        "sources": ["App Store API", "Play Store API", "APKMirror"],
        "action": "Download new version, flag for analysis",
        "priority": "HIGH",
        "notification": "Email to analyst"
      },
      {
        "trigger_id": "TRIGGER-003",
        "name": "Regulatory Filing",
        "query": "(Meta OR Facebook) + (facial recognition OR biometric) + (FTC OR EDPS OR ICO OR DPA)",
        "sources": ["FTC.gov", "EDPS.europa.eu", "ICO.org.uk"],
        "action": "Add to REGINT/ collection",
        "priority": "CRITICAL",
        "notification": "Telegram alert to analyst + legal"
      },
      {
        "trigger_id": "TRIGGER-004",
        "name": "Patent Filing",
        "query": "Meta + (facial recognition OR biometric OR NameTag) in patents",
        "sources": ["USPTO.gov", "WIPO.int"],
        "action": "Add to artifacts/documents/",
        "priority": "MEDIUM",
        "notification": "Weekly digest"
      },
      {
        "trigger_id": "TRIGGER-005",
        "name": "EFF/ACLU Statement",
        "query": "(EFF OR ACLU OR EPIC) + (Meta OR NameTag OR \"smart glasses\")",
        "sources": ["EFF.org", "ACLU.org", "EPIC.org"],
        "action": "Add to OSINT/ collection",
        "priority": "HIGH",
        "notification": "Email to analyst"
      },
      {
        "trigger_id": "TRIGGER-006",
        "name": "BIPA Litigation Filing",
        "query": "BIPA + Meta + (facial recognition OR biometric)",
        "sources": ["CourtListener", "PACER", "Law360"],
        "action": "Add to regulatory/enforcement-actions/",
        "priority": "CRITICAL",
        "notification": "Telegram alert to analyst + legal"
      }
    ],
